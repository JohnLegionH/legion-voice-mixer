# Keep the build context small and reproducible.
# The Dockerfile only needs: vendor/janus-gateway, Makefile, src/, tests/, and
# etc/janus/janus.plugin.slvoice.jcfg.

.git
**/.git
.gitignore
.gitmodules

# Secrets / operator config never belong in an image layer
secrets
.env

# Not needed to build the image
.github/
docker-compose.yml
env.sample

# Local build artifacts
*.o
*.lo
*.so
*.a
/build/
/out/
# compiled unit-test binaries (built by `make test`; recompiled inside the image)
tests/test_sldata
tests/test_mix
tests/test_visbatch
tests/test_roster

# Not needed at build time
docs/
*.md
.vscode/
.idea/
