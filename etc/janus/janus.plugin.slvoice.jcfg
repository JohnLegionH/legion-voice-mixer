# Configuration for the janus.plugin.slvoice spatial voice mixer.
#
# Phase 1 (echo test): rooms are primarily DYNAMIC — the OpenSim C# side
# creates them at runtime with the audiobridge-compatible `create`/`join`
# requests. This file is optional; the plugin runs with no config at all.
#
# The file uses the same libconfig/jcfg format as the stock Janus plugins.

general: {
	# Human-readable label surfaced in logs/admin (optional).
	#name = "Legion SLVoice mixer"

	# Set to true for very verbose per-tick logging once the mixer exists (Phase 2).
	#events = true
}

# ---- Optional static rooms -------------------------------------------------
# Rooms are normally created dynamically, but you may pre-declare a room here.
# Any category (other than `general`) that has a `room` key is loaded as a
# permanent room at startup. Example:
#
#room-100: {
#	room = 100                     # numeric room id (matches the C# CalcRoomNumber)
#	description = "Test Region"
#	sampling_rate = 48000          # advertised in `list`; internal mix is always 48k
#	is_private = false             # if true, hidden from `list`
#	spatial_audio = true           # advertised only; spatial mixing is Phase 2
#}

# ---- Notes -----------------------------------------------------------------
# Echo mode (Phase 1) is toggled per-participant over the WebRTC data channel
# via an {"echo": true} / {"echo": false} SLData message, NOT from this file.
# See docs/sldata-extensions.md.
#
# Phase 2 will grow per-region defaults here (spatial rolloff, max distance,
# stereo width, denoise). Extensions to the message protocol are added as NEW
# fields only — see docs/protocol-compat.md.
