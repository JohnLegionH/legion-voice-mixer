# Configuration for the janus.plugin.slvoice spatial voice mixer.
#
# Rooms are DYNAMIC: the OpenSim C# side creates them at runtime with the
# audiobridge-compatible `create`/`join` requests, and the plugin destroys an
# empty one after JS_EMPTY_ROOM_GRACE_S. This file is optional; the plugin runs
# with no config at all.
#
# The file uses the same libconfig/jcfg format as the stock Janus plugins.
# The spatial tuning keys (spatial_*_distance_m, spatial_falloff_exp) are
# documented in etc/janus/janus.plugin.slvoice.jcfg.

general: {
	# Diagnostic: auto-enable echo (participant hears itself ~500ms delayed) as soon
	# as its PeerConnection is up, so a stock viewer that can't send the
	# {"echo":true} SLData toggle still gets echo. Default false. Under the Docker
	# model the SLV_ECHO_AUTOSTART env var (add it to .env) is the easier knob and
	# overrides this. See docs/phase1-bringup.md (CHECK 2).
	#echo_autostart = false
}

# ---- Optional static rooms -------------------------------------------------
# Rooms are normally created dynamically, but you may pre-declare a room here.
# Any category (other than `general`) that has a `room` key is loaded as a
# permanent room at startup. Example:
#
#room-100: {
#	room = 100                     # numeric room id (matches the C# CalcRoomNumber)
#	description = "Test Region"
#	sampling_rate = 48000          # advertised in `list`; internal mix is always 48k
#	is_private = false             # if true, hidden from `list`
#	spatial_audio = true           # absent or true = distance cull, falloff and pan; false/no = a flat mix (O-80, O-83)
#}

# ---- Notes -----------------------------------------------------------------
# Echo (a per-participant diagnostic) is toggled over the WebRTC data channel
# via an {"echo": true} / {"echo": false} SLData message, NOT from this file.
# See docs/sldata-extensions.md.
#
# Spatial tuning is process-wide; there are no per-room spatial settings.
# Extensions to the message protocol are added as NEW fields only — see
# docs/protocol-compat.md.
