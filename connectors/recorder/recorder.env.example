# S-CON-4 recorder configuration. Copy to recorder.env (gitignored) and fill in.
# ROOM and DISPLAY come from the sim's registration line at region start:
#   [CONNECTOR] registered <name> npc=<DISPLAY> room=<ROOM> inject=... session=...

# JANUS_URL is NOT set here: docker-compose.yml derives it from the mixer's own
# .env — http://janus:${JS_HTTP_PORT}${JS_HTTP_BASEPATH} — so the recorder always
# targets the port Janus actually listens on (a hard-coded value here sent the
# first run to a closed port when the live .env used a non-default JS_HTTP_PORT).
# To point at a NON-compose Janus, set JANUS_URL in the mixer's .env; a value in
# this file is overridden by the compose-derived one.
# Must equal JS_API_SECRET in the mixer's .env (janus.jcfg api_secret).
JANUS_API_SECRET=
# The mixer room number from the sim's [CONNECTOR] registered line.
ROOM=
# The connector NPC's agent UUID from the same line — the display the exclusion
# column fans out to. Do NOT invent one; the sim's policy record owns it.
DISPLAY=
# Where WAV segments land inside the container (compose maps ./recordings here).
OUT_DIR=/recordings
# Segment length in seconds (one WAV file per segment).
SEGMENT_SECONDS=600
LOG_LEVEL=INFO
