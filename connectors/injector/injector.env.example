# S-CON-6 injector configuration. Copy to injector.env (gitignored) and fill in.
# ROOM and DISPLAY come from the sim's registration line at region start:
#   [CONNECTOR] registered <name> npc=<DISPLAY> room=<ROOM> inject=true session=...
# The record MUST carry MayInject=true — with inject=false the sim's moderation
# mute silences this peer for every listener (that is S-CON-5(e), by design).

# JANUS_URL is NOT set here: docker-compose.yml derives it from the mixer's own
# .env — http://janus:${JS_HTTP_PORT}${JS_HTTP_BASEPATH} — exactly as for the
# recorder. To point at a NON-compose Janus, set JANUS_URL in the mixer's .env;
# a value in this file is overridden by the compose-derived one.
# Must equal JS_API_SECRET in the mixer's .env (janus.jcfg api_secret).
JANUS_API_SECRET=
# The mixer room number from the sim's [CONNECTOR] registered line.
ROOM=
# The connector NPC's agent UUID from the same line — the identity the injected
# audio speaks as. Do NOT invent one; the sim's policy record owns it.
DISPLAY=
# The audio source: an s16 mono/stereo WAV file or named pipe (FIFO) inside the
# container. Compose maps ./injector-in on the host to /injector, so the default
# reads ./injector-in/in.wav. Exhausted/idle source = silence frames, not stop.
SOURCE=/injector/in.wav
# 1 = replay a regular file at EOF; 0 = play once, then silence. A FIFO always
# reopens at EOF for the next writer, regardless of LOOP.
LOOP=0
# 1 = also write the received room mixdown to WAV segments (the recorder's
# writer; segments land in OUT_DIR). 0 = receive and discard.
RECORD=0
# Where WAV segments land when RECORD=1 (compose maps ./recordings here).
OUT_DIR=/recordings
SEGMENT_SECONDS=600
LOG_LEVEL=INFO
