# Normalise this repo's own text files to LF, on every platform. This project
# targets Linux/Janus; CRLF would break the shell scripts and the Makefile.
# (The vendored Janus submodule is a gitlink and is unaffected by this file.)
* text=auto eol=lf

# Keep shell scripts and C explicitly LF
*.sh    text eol=lf
*.c     text eol=lf
*.h     text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf
*.jcfg  text eol=lf
*.yml   text eol=lf

# Byte-exact captures of generated config (slice 0.3's knobs-off golden): cmp'd against the image's output, so git
# must never rewrite their bytes. They are LF: upstream Janus commits its stock configs LF and the Dockerfile strips
# the CR a Windows (core.autocrlf) checkout of the submodule adds, so every platform builds the same templates.
tests/golden/phase0-knobs-off/** -text
