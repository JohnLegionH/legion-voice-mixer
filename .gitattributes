# Normalise this repo's own text files to LF, on every platform. This project
# targets Linux/Janus; CRLF would break the shell scripts and the Makefile.
# (The vendored Janus submodule is a gitlink and is unaffected by this file.)
* text=auto eol=lf

# Keep shell scripts and C explicitly LF
*.sh    text eol=lf
*.c     text eol=lf
*.h     text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf
*.jcfg  text eol=lf
*.yml   text eol=lf

# Byte-exact captures of generated config (slice 0.3's knobs-off golden). The stock Janus transport templates carry
# CRLF lines and the entrypoint copies them as they are, so these files must never be normalised.
tests/golden/phase0-knobs-off/** -text
