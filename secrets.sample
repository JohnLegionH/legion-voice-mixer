# Secret parameters for running Janus.
# These are the access tokens; updateConfiguration.sh merges them into the
# janus config files at run time.
#
# Copy this file to "secrets" and set real values. The "secrets" file is
# git-ignored on purpose.
#
# THESE ARE SECRETS!!!!
# NEVER, NEVER, NEVER CHECK THEM IN!!!
#
# Generate random values with:  uuidgen
# The same tokens must be set on the OpenSim side (os-webrtc-janus.ini:
#   [JanusWebRtcVoice] APIToken / AdminAPIToken).

JS_ADMIN_TOKEN=CHANGE-ME-admin-token
JS_API_TOKEN=CHANGE-ME-api-token
