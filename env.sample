# Legion SLVoice mixer configuration. Copy to `.env` and edit the values below.
# `.env` is read by `docker compose up -d`; the container turns these into Janus
# config at start. Only the first three are required.

# REQUIRED for any media/voice to work: the address this server advertises to clients for WebRTC (ICE nat_1_1_mapping). Under bridge networking Janus otherwise advertises the container's private IP and media fails, even same-host. An IPv4 literal is used as-is (e.g. the machine's LAN IP for same-network testing, or a static public IPv4). A hostname is discovered like JS_PUBLIC_HOST below. Leave blank only for signaling-only checks (e.g. GET /voice/info).
JS_PUBLIC_IP=
# For internet clients on a dynamic IP: a DNS/DDNS hostname (e.g. legiongrid.ddns.net). nat_1_1_mapping
# needs an IP literal, so the container DISCOVERS the public address at start (JS_PUBLIC_IP_DISCOVERY) and
# puts it first in the mapping, keeping a literal JS_PUBLIC_IP after it for LAN viewers. It refuses to start
# if no source finds an address. The start log shows what each source returned and which one won.
JS_PUBLIC_HOST=
# How a hostname becomes an address: auto (default) = STUN, then DNS via JS_PUBLIC_IP_DNS_RESOLVER, then the
# container resolver, first public answer wins. stun / dns = that source only. static = the container
# resolver only, at start, as before this knob existed. The container resolver is last because a router
# that hairpins its own DDNS name answers it with the LAN address.
#JS_PUBLIC_IP_DISCOVERY=auto
# STUN server for discovery (host:port or stun:host:port) and the external DNS resolver it asks directly.
#JS_STUN_SERVER=stun.l.google.com:19302
#JS_PUBLIC_IP_DNS_RESOLVER=1.1.1.1
# Re-check the discovered address every N seconds (0 disables). A change counts after 2 consecutive agreeing
# checks. JS_PUBLIC_IP_CHANGE_ACTION=warn logs the old and new address. restart waits until nobody is connected
# (at most JS_PUBLIC_IP_RESTART_MAX_WAIT_S, then restarts anyway) and stops Janus so the container restarts with
# the new address. restart needs `restart: unless-stopped` (or `always`) in docker-compose.yml.
#JS_PUBLIC_IP_REFRESH_S=300
#JS_PUBLIC_IP_CHANGE_ACTION=warn
#JS_PUBLIC_IP_RESTART_MAX_WAIT_S=900
# ICE: advertise BOTH the private and public host candidates (Janus keep_private_host). Defaults to
# true whenever a public address (JS_PUBLIC_HOST or JS_PUBLIC_IP) is set, so LAN viewers keep working
# without NAT hairpin/loopback while external viewers use the public address. Set false to advertise
# only the public candidate. Has no effect when no public address is set. See docs/docker-notes.md.
#JS_KEEP_PRIVATE_HOST=true
# Extra nat_1_1_mapping addresses (comma-separated IPv4), appended after the discovered and literal
# addresses; Janus advertises a host candidate for each. Rarely needed now that discovery finds the public
# address; a static value goes stale when a dynamic IP changes. The container logs an ERROR at start when
# no mapped address is public (off-LAN viewers then fail ICE), and a CGNAT warning for 100.64.0.0/10.
#JS_NAT_EXTRA_IPS=203.0.113.7
# REQUIRED. Shared API secret; must match the OpenSim region/grid os-webrtc-janus APIToken.
# The container REFUSES TO START if this or JS_ADMIN_SECRET is empty (O-65).
JS_API_SECRET=
# REQUIRED. Admin API secret guarding the Janus admin endpoint; must match os-webrtc-janus AdminAPIToken.
JS_ADMIN_SECRET=
# DEV ONLY: start even with an empty secret (throwaway local box; never on a reachable host).
#ALLOW_INSECURE_DEV=false
# UDP port range Janus uses for WebRTC media; open this range in your firewall.
JS_RTP_PORT_RANGE=10000-10200

# --- Optional (sensible defaults; usually left unchanged) ---
# Public name reported by GET <base_path>/info.
JS_SERVER_NAME=GridVoice
# HTTP signalling port (info endpoint = http://HOST:JS_HTTP_PORT/JS_HTTP_BASEPATH/info).
JS_HTTP_PORT=14223
# HTTP base path. Default /voice matches the os-webrtc-janus OpenSim convention; set /janus for a generic Janus setup.
JS_HTTP_BASEPATH=/voice
# Admin/monitor HTTP port.
JS_ADMIN_PORT=14225
# Host address the Admin API is published on (O-55). Unset = all interfaces, as before the knob
# existed; the container then WARNs at start, since only JS_ADMIN_SECRET protects the admin API.
# To narrow, set it to the address in the sim's JanusGatewayAdminURI (e.g. the LAN IP). 127.0.0.1
# only works if the sim calls http://127.0.0.1:<port>; a sim on another host needs this host's address.
#JS_ADMIN_BIND=192.168.1.225
# Admin/monitor base path. Default /voiceAdmin matches os-webrtc-janus; set /admin for stock Janus.
JS_ADMIN_BASEPATH=/voiceAdmin
# WebSockets signalling transport (O-55). Default true, as before the knob existed. The OpenSim sim
# uses HTTP only, so false narrows: Janus then does not load the transport (the mapped port answers nothing).
#JS_WS_ENABLED=true
JS_WS_PORT=8188

# Phase 1B echo test. When true, the slvoice plugin echoes each participant's own
# audio back to them ~500ms delayed as soon as they connect. Stock viewers
# (Firestorm et al.) cannot send the {"echo":true} SLData toggle, so this env knob
# is how you turn echo on. Leave false for normal (silent) operation; set true for
# the echo acceptance run, then set back to false. See docs/phase1-bringup.md.
SLV_ECHO_AUTOSTART=false

# Empty-room grace (O-54). A dynamically created mixer room (every parcel/estate room and every
# avatar-to-avatar call) that has had no participants for this many seconds is destroyed, freeing
# its 50 Hz mix thread. The sim re-creates it on the next provision. 0 disables (rooms then live
# until the mixer restarts). Default 60.
#JS_EMPTY_ROOM_GRACE_S=60

# Join-media timeout (O-75). A participant that joins a room but whose PeerConnection never comes up
# (ICE/DTLS never completes) is removed from the room after this many seconds, freeing its mix slot and
# letting the room's grace destroy run; the viewer re-provisions and joins again. 0 disables (such a
# participant then stays until its Janus session ends). Default 30. This default changed behaviour on
# upgrade — see docs/RELEASES.md.
#JS_JOIN_MEDIA_TIMEOUT_S=30
